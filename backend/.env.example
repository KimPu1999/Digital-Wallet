APP_NAME="Digital Wallet Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAIL_MAILER=log
MAIL_LOG_CHANNEL=single
LOG_LEVEL=debug
MAIL_FROM_ADDRESS=hello@moneta.local
MAIL_FROM_NAME="Moneta Sandbox"
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=digital_wallet
DB_USERNAME=postgres
DB_PASSWORD=
SESSION_DRIVER=database
CACHE_STORE=database
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
LOG_LEVEL=debug
LOG_FORMAT=single
REDIS_HEALTHCHECK=false
PAYMENT_SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
FINANCIAL_EXECUTION_ENABLED=false
OTEL_ENABLED=false
