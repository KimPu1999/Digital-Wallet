{
  "title": "Digital Wallet Platform Operations",
  "schemaVersion": 39,
  "tags": ["wallet", "sandbox", "operations"],
  "templating": {"list": [{"name": "environment", "type": "query", "query": "label_values(environment)"}]},
  "panels": [
    {"type": "stat", "title": "API request rate", "targets": [{"expr": "sum(rate(http_server_requests_total[5m]))"}]},
    {"type": "timeseries", "title": "API P95 latency", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le))"}]},
    {"type": "stat", "title": "Queue backlog", "targets": [{"expr": "wallet_queue_backlog"}]},
    {"type": "stat", "title": "Reconciliation exceptions", "targets": [{"expr": "wallet_reconciliation_exceptions"}]},
    {"type": "stat", "title": "Last backup age", "targets": [{"expr": "time() - wallet_last_successful_backup_timestamp"}]}
  ]
}
